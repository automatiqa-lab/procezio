{
  "name": "@procezio/schema",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Automatiqa Lab by Aleks Sidorecs <automate@automati.qa>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/validators.cjs",
      "default": "./src/validators.cjs"
    },
    "./canvas.schema.json": "./canvas.schema.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "gen": "node ../scripts/gates/schema-drift.mjs --write",
    "gen:validators": "node ../scripts/gates/validators-drift.mjs --write",
    "gen:ruleset": "node ../scripts/gates/ruleset-drift.mjs --write",
    "gen:prompt-pack": "node ../scripts/gates/prompt-pack-drift.mjs --write",
    "gen:templates": "node ../scripts/gates/templates-drift.mjs --write"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "15.0.4"
  }
}
