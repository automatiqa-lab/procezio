    { "id": "car-insurance", "type": "Step", "lane": "Compliance", "label": "Verify insurance" },
    { "id": "car-credit", "type": "Step", "lane": "Finance", "label": "Run credit check" },
    { "id": "car-setup", "type": "Step", "lane": "Ops", "label": "Set up in TMS" },
